{
  "name": "arc-chrome-extension",
  "private": true,
  "version": "1.4.0",
  "description": "Arc Browser experience in Chrome: Vertical Sidebar Spaces, Favorites, Pinned Tabs, Command Bar (Cmd+K), Little Arc / Peek, and Highlight-to-Translate",
  "type": "module",
  "scripts": {
    "build:safari": "node scripts/build-safari.mjs",
    "build:ipad": "node scripts/build-ipad.mjs",
    "dev": "vite build --watch",
    "build": "node scripts/build-extension.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "npm run build && node scripts/test-e2e.mjs",
    "test:e2e:arc": "E2E_BROWSERS=arc npm run test:e2e",
    "build:desktop-pip": "node scripts/build-desktop-pip.mjs",
    "install:desktop-pip": "npm run build:desktop-pip && node scripts/install-desktop-pip.mjs",
    "cast:setup": "python3 -m venv native/cast/.venv && native/cast/.venv/bin/python -m pip install -r native/cast/requirements.txt",
    "cast:serve": "native/cast/.venv/bin/python native/cast/serve.py",
    "build:tv": "node scripts/build-tv.mjs",
    "tv:serve": "npm run build:tv && python3 -m native.tv.serve",
    "mac:up": "bash scripts/mac-up.sh",
    "build:mac": "bash arc-browser/scripts/build.sh",
    "run:mac": "bash arc-browser/scripts/run.sh",
    "test:mac": "bash arc-browser/scripts/test.sh",
    "build:ios": "bash arc-browser/scripts/ios.sh build",
    "run:ios": "bash arc-browser/scripts/ios.sh run",
    "test:ios": "bash arc-browser/scripts/ios.sh test",
    "install:arc-sync": "node scripts/install-arc-sync.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "parse5": "^8.1.1"
  }
}
