{
  "name": "arc-chrome-extension",
  "private": true,
  "version": "1.3.2",
  "description": "Arc Browser experience in Chrome: Vertical Sidebar Spaces, Favorites, Pinned Tabs, Command Bar (Cmd+K), Little Arc / Peek, and Highlight-to-Translate",
  "type": "module",
  "scripts": {
    "build:safari": "node scripts/build-safari.mjs",
    "build:ipad": "node scripts/build-ipad.mjs",
    "dev": "vite build --watch",
    "build": "node scripts/build-extension.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "npm run build && node scripts/test-e2e.mjs",
    "test:e2e:arc": "E2E_BROWSERS=arc npm run test:e2e",
    "build:desktop-pip": "node scripts/build-desktop-pip.mjs",
    "install:desktop-pip": "npm run build:desktop-pip && node scripts/install-desktop-pip.mjs"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "parse5": "^8.1.1"
  }
}
