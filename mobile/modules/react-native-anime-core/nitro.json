{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "animecore"
  ],
  "ios": {
    "iosModuleName": "NitroAnimeCore"
  },
  "android": {
    "androidNamespace": [
      "animecore"
    ],
    "androidCxxLibName": "NitroAnimeCore"
  },
  "autolinking": {
    "AnimeCore": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridAnimeCore"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
